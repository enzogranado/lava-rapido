// Prisma schema for Sistema Lava Rápido
// Database: SQLite (can be migrated to PostgreSQL later)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles         Vehicle[]
  washes           Wash[]
  whatsappMessages WhatsAppMessage[]

  @@index([name])
  @@index([phone])
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String
  model      String
  plate      String   @unique
  color      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  washes   Wash[]

  @@index([plate])
  @@index([customerId])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  washItems WashItem[]

  @@index([active])
}

model Wash {
  id          String    @id @default(cuid())
  customerId  String
  vehicleId   String
  status      String    @default("WAITING") // WAITING, IN_SERVICE, FINISHING, READY, DELIVERED, CANCELLED
  subtotal    Float     @default(0)
  discount    Float     @default(0)
  total       Float     @default(0)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id])
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  items            WashItem[]
  whatsappMessages WhatsAppMessage[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

model WashItem {
  id                  String @id @default(cuid())
  washId              String
  serviceId           String
  serviceNameSnapshot String
  unitPrice           Float
  quantity            Int    @default(1)
  total               Float

  wash    Wash    @relation(fields: [washId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([washId])
  @@index([serviceId])
}

model WhatsAppMessage {
  id                String    @id @default(cuid())
  customerId        String
  washId            String?
  phone             String
  message           String
  status            String    @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  externalMessageId String?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  wash     Wash?    @relation(fields: [washId], references: [id])

  @@index([customerId])
  @@index([washId])
  @@index([status])
}

model Settings {
  id                   String @id @default("default")
  businessName         String @default("Meu Lava Rápido")
  inactiveDaysLimit    Int    @default(45)
  whatsappMessageTemplate String @default("Olá, {nome}! 🚗✨\n\nSeu {modelo} — placa {placa} — ficou pronto e já está disponível para retirada.\n\nObrigado por confiar em nosso lava-rápido! 🚿")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
