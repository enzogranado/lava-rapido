// Prisma schema for LavaFlow (Multi-Tenant Architecture)
// Database: SQLite (can be migrated to PostgreSQL later)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                       String    @id @default(cuid())
  name                     String
  slug                     String    @unique
  phone                    String?
  email                    String?
  active                   Boolean   @default(false)
  status                   String    @default("PENDING") // PENDING, APPROVED, REJECTED
  paymentStatus            String    @default("PENDING") // PAID, PENDING, OVERDUE
  monthlyFee               Float     @default(99.00)
  lastPaymentDate          DateTime?
  dashboardPin             String    @default("1234")
  pendingPinChange         String?
  pinChangeReason          String?
  pinChangeStatus          String? // null, PENDING, APPROVED, REJECTED
  inactiveDaysLimit        Int       @default(45)
  whatsappMessageTemplate  String    @default("Olá, {nome}! 🚗✨\n\nSeu {modelo} — placa {placa} — ficou pronto e já está disponível para retirada.\n\nObrigado por confiar em nosso lava-rápido! 🚿")
  whatsappRecallTemplate   String    @default("Olá, {nome}! 🚗✨\n\nSentimos sua falta aqui no lava-rápido! Notamos que faz {dias} dias que seu veículo não faz uma higienização.\n\nQue tal agendar uma lavagem hoje? 🚿")
  whatsappTrackingTemplate String    @default("Olá, {nome}! 🚗✨\n\nSeu {modelo} — placa {placa} — acabou de entrar na nossa lavagem!\n\nAcompanhe o status em tempo real por aqui:\n{link}\n\nVamos te avisando a cada etapa! 🚿")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  users            User[]
  customers        Customer[]
  vehicles         Vehicle[]
  services         Service[]
  washes           Wash[]
  whatsappMessages WhatsAppMessage[]
  monthlyPlans     MonthlyPlan[]
  mensalistas      Mensalista[]
  mensalistaExtras MensalistaExtra[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String?  @default("tenant-default")
  name      String
  email     String   @unique
  password  String
  role      String   @default("TENANT_ADMIN") // "SUPER_ADMIN", "TENANT_ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String   @default("tenant-default")
  name      String
  phone     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles         Vehicle[]
  washes           Wash[]
  whatsappMessages WhatsAppMessage[]
  mensalistas      Mensalista[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([name])
  @@index([phone])
}

model Vehicle {
  id         String   @id @default(cuid())
  tenantId   String   @default("tenant-default")
  customerId String
  model      String
  plate      String
  color      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  washes      Wash[]
  mensalistas Mensalista[]

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@index([plate])
  @@index([customerId])
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant-default")
  name        String
  description String?
  price       Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  washItems        WashItem[]
  mensalistaExtras MensalistaExtra[]

  @@index([tenantId])
  @@index([active])
}

model Wash {
  id                 String    @id @default(cuid())
  tenantId           String    @default("tenant-default")
  customerId         String
  vehicleId          String
  status             String    @default("WAITING") // WAITING, IN_SERVICE, READY, DELIVERED, CANCELLED
  subtotal           Float     @default(0)
  discount           Float     @default(0)
  total              Float     @default(0)
  notes              String?
  pickupCode         String?
  trackingToken      String?   @unique
  paymentMethod      String? // MONEY, PIX, DEBIT, CREDIT
  pickupCodeBypassed Boolean   @default(false)
  startedAt          DateTime?
  completedAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id])
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  items            WashItem[]
  whatsappMessages WhatsAppMessage[]
  mensalistaExtras MensalistaExtra[]

  @@index([tenantId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

model WashItem {
  id                  String @id @default(cuid())
  washId              String
  serviceId           String
  serviceNameSnapshot String
  unitPrice           Float
  quantity            Int    @default(1)
  total               Float

  wash    Wash    @relation(fields: [washId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([washId])
  @@index([serviceId])
}

model WhatsAppMessage {
  id                String    @id @default(cuid())
  tenantId          String    @default("tenant-default")
  customerId        String
  washId            String?
  phone             String
  message           String
  type              String    @default("READY") // READY, ENTRY_CODE, TRACKING, RECALL
  status            String    @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  externalMessageId String?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  wash     Wash?    @relation(fields: [washId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([washId])
  @@index([status])
}

model Settings {
  id                      String   @id @default("default")
  businessName            String   @default("LavaFlow")
  inactiveDaysLimit       Int      @default(45)
  whatsappMessageTemplate String   @default("Olá, {nome}! 🚗✨\n\nSeu {modelo} — placa {placa} — ficou pronto e já está disponível para retirada.\n\nObrigado por confiar em nosso lava-rápido! 🚿")
  whatsappRecallTemplate  String   @default("Olá, {nome}! 🚗✨\n\nSentimos sua falta aqui no lava-rápido! Notamos que faz {dias} dias que seu veículo não faz uma higienização.\n\nQue tal agendar uma lavagem hoje? 🚿")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model MonthlyPlan {
  id             String   @id @default(cuid())
  tenantId       String   @default("tenant-default")
  name           String
  price          Float
  washesIncluded Int? // null = ilimitado
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mensalistas Mensalista[]

  @@index([tenantId])
}

model Mensalista {
  id              String    @id @default(cuid())
  tenantId        String    @default("tenant-default")
  customerId      String
  vehicleId       String?
  planId          String
  status          String    @default("ATIVO") // ATIVO, CANCELADO, INATIVO
  paymentMethod   String? // MONEY, PIX, DEBIT, CREDIT
  dueDay          Int // 1-28
  lastPaymentDate DateTime?
  startedAt       DateTime  @default(now())
  cancelledAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id])
  vehicle  Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  plan     MonthlyPlan       @relation(fields: [planId], references: [id])
  extras   MensalistaExtra[]

  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

model MensalistaExtra {
  id           String    @id @default(cuid())
  tenantId     String    @default("tenant-default")
  mensalistaId String
  washId       String?
  serviceId    String?
  description  String
  amount       Float
  category     String    @default("WASH") // WASH, SERVICE, REPAIR, OTHER
  status       String    @default("PENDING") // PENDING, PAID
  billingMonth String?   // Ex: "2026-08"
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mensalista Mensalista @relation(fields: [mensalistaId], references: [id], onDelete: Cascade)
  wash       Wash?      @relation(fields: [washId], references: [id], onDelete: SetNull)
  service    Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, mensalistaId])
  @@index([status])
}

